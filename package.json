{
	"name": "oberry",
	"version": "1.12.0",
	"description": "A lightweight and modern jQuery alternative for DOM manipulation, user interactions, and reactive data binding",
	"main": "dist/index.mjs",
	"module": "dist/index.mjs",
	"exports": {
		"import": "./dist/index.mjs"
	},
	"types": "dist/index.d.mts",
	"files": [
		"dist/**/*",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"build": "tsdown src/index.ts --dts",
		"prepublishOnly": "pnpm run build",
		"dev": "tsdown src/index.ts --watch --dts",
		"clean": "rm -rf dist",
		"format": "pnpm biome check --write",
		"lint": "pnpm biome check",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:ui": "vitest --ui",
		"prepare": "husky"
	},
	"keywords": [
		"dom",
		"manipulation",
		"jquery",
		"alternative",
		"reactive",
		"data-binding",
		"typescript",
		"frontend",
		"javascript",
		"selector",
		"signals"
	],
	"author": "Radosław Kaczmarczyk",
	"license": "MIT",
	"homepage": "https://github.com/radeqq007/oberry#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/radeqq007/oberry.git"
	},
	"bugs": {
		"url": "https://github.com/radeqq007/oberry/issues"
	},
	"packageManager": "pnpm@10.33.0",
	"dependencies": {
		"alien-signals": "^3.1.2"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "3.2.4",
		"@vitest/ui": "3.2.4",
		"alien-signals": "^3.1.2",
		"happy-dom": "^20.9.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.0.5",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^3.2.4"
	},
	"lint-staged": {
		"*.{js,ts,cjs,mjs,d.cts,d.mts,d.ts,json,jsonc}": [
			"biome check --write --files-ignore-unknown=true"
		]
	}
}
